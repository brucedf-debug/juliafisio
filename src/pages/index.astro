---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { categories, type CategorySlug } from '../lib/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categoryEntries = Object.entries(categories) as [CategorySlug, (typeof categories)[CategorySlug]][];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				padding-top: 0;
			}
			.hero {
				text-align: center;
				padding: 3.5em 1em 3em;
			}
			.hero h1 {
				font-size: 2.4em;
				margin-bottom: 0.4em;
			}
			.hero p {
				color: rgb(var(--gray));
				font-size: 1.15em;
				max-width: 34em;
				margin: 0 auto;
			}
			.categories {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.6em;
				margin: 0 0 2.5em;
			}
			.categories a {
				display: inline-block;
				padding: 0.4em 1em;
				border-radius: 999px;
				background: var(--accent-light);
				color: var(--accent-dark);
				font-size: 0.85em;
				font-weight: 600;
				text-decoration: none;
			}
			.categories a:hover {
				background: var(--accent);
				color: white;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.75rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			@media (max-width: 900px) {
				.grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 640px) {
				.grid {
					grid-template-columns: 1fr;
				}
				.hero {
					padding: 2.5em 0 2em;
				}
				.hero h1 {
					font-size: 1.8em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Fisioterapia explicada de forma simples</h1>
				<p>{SITE_DESCRIPTION}</p>
			</div>
			<nav class="categories" aria-label="Categorias">
				{
					categoryEntries.map(([slug, meta]) => (
						<a href={`/category/${slug}/`}>{meta.name}</a>
					))
				}
			</nav>
			<section>
				<div class="grid">
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
